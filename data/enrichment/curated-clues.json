            "title": "Terra Blade - Official Terraria Wiki",
            "url": "https://terraria.wiki.gg/wiki/Terrablade",
            "license": "CC BY-NC-SA 4.0; original clue wording",
            "accessedAt": "2026-08-20"
          }
