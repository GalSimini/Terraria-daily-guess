          }
        }
      ]
    },
    {
      "entityId": "item:757",
      "review": {
        "approvedBy": "GalSimini",
        "approvedAt": "2026-08-20"
      },
      "clues": [
        {
          "source": "progression",
          "text": "This melee weapon belongs to the Hardmode stage after Plantera has been defeated.",
          "reference": {
            "title": "Terra Blade - Official Terraria Wiki",
